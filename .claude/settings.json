{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "mcp__ide__getDiagnostics"
    ],
    "ask": [
      "Edit(pixi.toml)",
      "Edit(**/pixi.toml)",
      "Edit(docker-compose*.yaml)",
      "Edit(**/docker-compose*.yaml)",
      "Edit(**/docker-compose*.yml)",
      "Bash(*git push*main*)",
      "Bash(*git push*master*)",
      "Bash(*git push*--force*)",
      "Bash(*git push* -f*)",
      "Bash(*git push*--delete*)",
      "Bash(*git push* -d *)",
      "Bash(*git push*--mirror*)",
      "Bash(*git push*+*)",
      "Bash(*gh pr merge*)",
      "Bash(*gh pr ready*)",
      "Bash(*gh pr close*)",
      "Bash(*gh pr revert*)",
      "Bash(*gh pr review*)",
      "Bash(*gh pr comment*)",
      "Bash(*gh pr edit*)",
      "Bash(*gh pr update-branch*)",
      "Bash(*gh run cancel*)",
      "Bash(*gh stack*)",
      "Bash(*gh issue create*)",
      "Bash(*gh issue comment*)",
      "Bash(*gh issue edit*)",
      "Bash(*gh issue close*)",
      "Bash(*gh issue reopen*)",
      "Bash(*gh issue delete*)",
      "Bash(*gh issue transfer*)",
      "Bash(*gh issue pin*)",
      "Bash(*gh issue unpin*)",
      "Bash(*gh issue lock*)",
      "Bash(*gh issue unlock*)",
      "Bash(*gh issue develop*)",
      "Bash(*docker compose up*)",
      "Bash(*docker compose down*)",
      "Bash(*docker compose restart*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true,
      "deniedDomains": [
        "conda.anaconda.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/tmp/claude",
        "~/Library/Caches/rattler",
        "~/.cache/rattler",
        "~/.cache/pre-commit",
        "/tmp/pipedag",
        "/private/tmp/pipedag"
      ],
      "denyWrite": [
        "pixi.toml",
        "docker-compose.yaml"
      ]
    },
    "excludedCommands": [
      "git fetch*",
      "git pull*",
      "git push*",
      "git ls-remote*",
      "gh run view *",
      "gh run list*",
      "gh run download *",
      "gh run watch*",
      "gh run cancel*",
      "gh run rerun*",
      "gh pr checks*",
      "gh pr diff*",
      "gh pr view*",
      "gh pr list*",
      "gh pr status*",
      "gh pr checkout*",
      "gh pr create*",
      "gh pr merge*",
      "gh pr edit*",
      "gh pr close*",
      "gh pr comment*",
      "gh pr ready*",
      "gh pr revert*",
      "gh pr review*",
      "gh pr update-branch*",
      "gh stack*",
      "gh issue view*",
      "gh issue list*",
      "gh issue status*",
      "gh issue create*",
      "gh issue comment*",
      "gh issue edit*",
      "gh issue close*",
      "gh issue reopen*",
      "gh issue delete*",
      "gh issue transfer*",
      "gh issue pin*",
      "gh issue unpin*",
      "gh issue lock*",
      "gh issue unlock*",
      "gh issue develop*",
      "gh api repos/pydiverse/pydiverse.pipedag/actions/jobs/*/logs",
      "gh api --allow-escape-sequences repos/pydiverse/pydiverse.pipedag/actions/jobs/*/logs",
      "pixi lock*",
      "pixi update*",
      "pixi install*",
      "docker ps*",
      "docker logs *",
      "docker compose ps*",
      "docker compose logs*",
      "docker compose up*",
      "docker compose down*",
      "docker compose restart*",
      "grep *",
      "head *",
      "tail *"
    ]
  }
}
